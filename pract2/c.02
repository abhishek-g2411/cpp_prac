#include <iostream>
#include <cmath> // Required for abs() function

using namespace std;

int main() {
    int t;
    // Read the number of test cases
    cin >> t;
    
    while (t--) {
        int x, y;
        // Read the initial and final volume
        cin >> x >> y;
        
        // The result is the absolute difference between X and Y
        cout << abs(x - y) << endl;
    }
    
    return 0;
}